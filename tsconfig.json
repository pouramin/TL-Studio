{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["DOM", "ES2020", "DOM.Iterable"],
    "rootDir": "cmd/launcher/ui",
    "outDir": "cmd/launcher/web",
    "strict": true,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["cmd/launcher/ui/**/*.ts", "cmd/launcher/ui/**/*.d.ts"],
  "exclude": ["cmd/launcher/ui/runtime-contract.ts"]
}
